<?php

declare(strict_types=1);

namespace App\Components\Psx;

use Polidog\UsePhp\Html\H;
use Polidog\UsePhp\Storage\StorageType;

use function Polidog\UsePhp\Runtime\fc;
use function Polidog\UsePhp\Runtime\useState;

return fc(function (array $props) {
    [$count, $setCount] = useState($props['initial'] ?? 0);

    return <div className="counter">
        <h1>usePHP Counter (PSX)</h1>
        <div className="counter-display">
            <span>Count: {$count}</span>
        </div>
        <div className="counter-buttons">
            <button className="btn btn-decrement" onClick={fn() => $setCount($count - 1)}>-</button>
            <button className="btn btn-increment" onClick={fn() => $setCount($count + 1)}>+</button>
            <button className="btn btn-reset" onClick={fn() => $setCount(0)}>Reset</button>
        </div>
    </div>;
}, 'psx-counter', StorageType::Snapshot);
