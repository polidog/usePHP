<?php

declare(strict_types=1);

namespace App\Components\Psx;

use Polidog\UsePhp\Html\H;

return fn(array $props) => (
    <div className="card">
        <h3 className="card-title">{$props['title']}</h3>
        <div className="card-body">
            {$props['children'] ?? null}
        </div>
    </div>
);
