<?php

declare(strict_types=1);

namespace App\Components\Psx;

use Polidog\UsePhp\Html\H;

use App\Components\Psx\Card;
use App\Components\Psx\Counter;
use App\Components\Psx\HeaderSkeleton;
use App\Components\Psx\UserHeaderDeferred;

return fn(array $props) => (
    <div className="page">
        <UserHeaderDeferred fallback={<HeaderSkeleton />} />
        <h1>PSX demo</h1>
        <Card title="Stateful counter">
            <Counter initial={10} />
        </Card>
        <Card title="About PSX">
            <p>This page is composed of four .psx files (Page, Card, Counter, UserHeader).</p>
            <p>FQCNs are resolved via PHP `use` statements; the manifest is generated by `usephp compile`.</p>
        </Card>
    </div>
);
