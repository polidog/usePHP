<?php

declare(strict_types=1);

namespace App\Components\Psx;

use Polidog\UsePhp\Html\H;

use App\Components\Psx\Card;
use App\Components\Psx\Counter;

return fn(array $props) => <div className="page">
    <h1>PSX demo</h1>
    <Card title="Stateful counter">
        <Counter initial={10} />
    </Card>
    <Card title="About PSX">
        <p>This page is composed of three .psx files (Page, Card, Counter).</p>
        <p>FQCNs are resolved via PHP `use` statements; the manifest is generated by `usephp compile`.</p>
    </Card>
</div>;
